# ── Printify (print-on-demand fulfillment) ─────────────────────────────────
# Used by /api/printify/create-product to upload the generated artwork and
# create a draft product in your Printify shop. Without these set, the
# route returns a stubbed "would create" payload instead of calling Printify.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Printify catalog IDs, one blueprint/print-provider pair per sellable
# garment. Find these under https://developers.printify.com/#catalog once
# you've picked the exact blank (e.g. Gildan 5000, Comfort Colors 1717,
# Yupoong 6089M cap) and a print provider that offers it. Both IDs are
# required to create that garment; leaving either blank stub-only's it.
PRINTIFY_TSHIRT_GILDAN_BLUEPRINT_ID=
PRINTIFY_TSHIRT_GILDAN_PRINT_PROVIDER_ID=
PRINTIFY_TSHIRT_COMFORT_BLUEPRINT_ID=
PRINTIFY_TSHIRT_COMFORT_PRINT_PROVIDER_ID=
PRINTIFY_CAP_BLUEPRINT_ID=
PRINTIFY_CAP_PRINT_PROVIDER_ID=
