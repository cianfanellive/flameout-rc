# ── OpenAI (design generation) ─────────────────────────────────────────────
# Used by /api/generate-design to turn a customer's rig + color + style
# choices into a print-ready graphic via the Images API (gpt-image-1).
# Without this set, the route falls back to a locally-built placeholder
# badge (same colors/layout) so the whole flow still demos end to end.
OPENAI_API_KEY=

# ── Printify (print-on-demand fulfillment) ─────────────────────────────────
# Used by /api/printify/create-product to upload the generated artwork and
# create a draft product in your Printify shop. Without these set, the
# route returns a stubbed "would create" payload instead of calling Printify.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Printify catalog IDs for the two garments this store sells. Find these
# under https://developers.printify.com/#catalog once you've picked the
# exact blueprint (e.g. Bella+Canvas 3001 tee, Yupoong 6089M cap) and a
# print provider that offers it. Both are required to create that garment;
# leaving either blank stub-only's that garment.
PRINTIFY_TSHIRT_BLUEPRINT_ID=
PRINTIFY_TSHIRT_PRINT_PROVIDER_ID=
PRINTIFY_CAP_BLUEPRINT_ID=
PRINTIFY_CAP_PRINT_PROVIDER_ID=
